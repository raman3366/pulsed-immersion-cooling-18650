FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    inlet
    {
        type            flowRateInletVelocity;
        volumetricFlowRate
        {
            type            scale;
            scale
            {
                type            linearRamp;
                start           0;
                duration        2;
            }
            value
            {
                type            sine;
                frequency       1;
                amplitude       1;
                scale           6e-07;
                level           1.5e-06;
                t0              0;
            }
        }
        value           uniform ( 0 0 0 );
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform ( 0 0 0 );
    }
    walls
    {
        type            noSlip;
    }
    fluid_to_cell4
    {
        type            noSlip;
        value           uniform ( 0 0 0 );
    }
    fluid_to_cell2
    {
        type            noSlip;
        value           uniform ( 0 0 0 );
    }
    fluid_to_cell5
    {
        type            noSlip;
        value           uniform ( 0 0 0 );
    }
    fluid_to_cell0
    {
        type            noSlip;
        value           uniform ( 0 0 0 );
    }
    fluid_to_cell3
    {
        type            noSlip;
        value           uniform ( 0 0 0 );
    }
    fluid_to_cell1
    {
        type            noSlip;
        value           uniform ( 0 0 0 );
    }
}


